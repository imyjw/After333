<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Compile Include="LoadChecks.cs" />
    <Reference Include="Project333.PvpServer"><HintPath>$(ServerOutput)\Project333.PvpServer.dll</HintPath></Reference>
    <Reference Include="Npgsql"><HintPath>$(ServerOutput)\Npgsql.dll</HintPath></Reference>
    <Content Include="$(ServerOutput)\Data\*.json" Link="Data\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireBuiltServer" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ServerOutput)\Project333.PvpServer.dll')" Text="Pass -p:ServerOutput=the freshly built isolated server output directory." />
  </Target>
</Project>
